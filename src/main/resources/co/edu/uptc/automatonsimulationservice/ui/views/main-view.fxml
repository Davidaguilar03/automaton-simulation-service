<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.automatonsimulationservice.ui.controllers.MainController">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" right="10.0" bottom="6.0" left="10.0"/>
            </padding>
            <Label text="Universal Finite Automata Simulator and Analyzer" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <ToolBar>
                <ToggleButton fx:id="selectToolButton" text="Select"/>
                <ToggleButton fx:id="addStateToolButton" text="State"/>
                <ToggleButton fx:id="addTransitionToolButton" text="Transition"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Type"/>
                <ComboBox fx:id="automatonTypeComboBox" prefWidth="110.0"/>
                <Separator orientation="VERTICAL"/>
                <Button text="Validate" onAction="#onValidateAutomaton"/>
                <Button text="Import JSON" onAction="#onImportJson"/>
                <Button text="Export JSON" onAction="#onExportJson"/>
                <Button text="Clear" onAction="#onClearAutomaton"/>
                <Button text="Test" onAction="#onOpenTestWindow"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="validationMessageLabel"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <Pane fx:id="automatonDiagramPane" style="-fx-background-color: #f8fafc; -fx-border-color: #d1d5db; -fx-border-radius: 4; -fx-background-radius: 4;" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="0.0" right="0.0" bottom="10.0" left="10.0"/>
            </BorderPane.margin>
        </Pane>
    </center>

    <right>
        <VBox spacing="8.0" prefWidth="270.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <Label text="Automaton Summary" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <HBox spacing="8.0">
                <Label text="Initial:"/>
                <Label fx:id="initialStateValueLabel" text="-"/>
            </HBox>

            <Label text="States"/>
            <ListView fx:id="statesListView" prefHeight="130.0" VBox.vgrow="ALWAYS"/>

            <Label text="Alphabet"/>
            <ListView fx:id="alphabetListView" prefHeight="110.0" VBox.vgrow="ALWAYS"/>

            <Label text="Final States"/>
            <ListView fx:id="acceptingStatesListView" prefHeight="130.0" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>
</BorderPane>

